#!/usr/bin/env bash
# ==============================================================================
# Antigravity & Codex Remote CLI Manager
# Controls Bridge Server, Cloudflare Tunnel, and QR Code Pairing
# ==============================================================================

set -e

APP_DIR="/home/ubuntu/codexcli-remote-app"
if [ ! -d "$APP_DIR" ]; then
    APP_DIR="$HOME/.codex-remote/app"
fi
if [ ! -d "$APP_DIR" ]; then
    if [ -f "./bridge/server.js" ]; then
        APP_DIR="$(pwd)"
    elif [ -f "../bridge/server.js" ]; then
        APP_DIR="$(cd .. && pwd)"
    fi
fi

DATA_DIR="$HOME/.codex-remote"
mkdir -p "$DATA_DIR"

PID_FILE="$DATA_DIR/bridge.pid"
TUNNEL_PID_FILE="$DATA_DIR/tunnel.pid"
LOG_FILE="$DATA_DIR/bridge.log"
TUNNEL_LOG="$DATA_DIR/tunnel.log"
ENV_FILE="$DATA_DIR/env"

DEFAULT_PORT="8787"
DEFAULT_ENGINE="antigravity"
LEGACY_TOKEN="codex-remote-token-2026"

if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
fi

# A stale REMOTE_TOKEN in the env file used to override the real secret and
# get baked into the QR code, so the phone paired with a token the server
# had already replaced. Never trust the legacy default from any source.
if [ "$REMOTE_TOKEN" = "$LEGACY_TOKEN" ]; then
    REMOTE_TOKEN=""
fi

PORT="${BRIDGE_PORT:-$DEFAULT_PORT}"
ENGINE="${DEFAULT_ENGINE:-antigravity}"

# ~/.codex-remote/token is the single source of truth, shared with the server.
read_token() {
    node -e "process.stdout.write(require('$APP_DIR/bridge/config.js').loadToken())" 2>/dev/null
}

write_token() {
    node -e "require('fs');const c=require('$APP_DIR/bridge/config.js');const fs=require('fs');fs.mkdirSync(c.CONFIG_DIR,{recursive:true,mode:0o700});fs.writeFileSync(c.TOKEN_FILE,process.argv[1]+'\n',{mode:0o600});" "$1" 2>/dev/null
}

TOKEN="${REMOTE_TOKEN:-$(read_token)}"

save_env() {
    cat <<EOENV > "$ENV_FILE"
BRIDGE_PORT="$PORT"
DEFAULT_ENGINE="$ENGINE"
EOENV
}

is_bridge_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    if command -v lsof >/dev/null 2>&1; then
        if lsof -i :"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

is_tunnel_running() {
    if [ -f "$TUNNEL_PID_FILE" ]; then
        local pid
        pid=$(cat "$TUNNEL_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

systemd_manages() {
    command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$1"
}

start_bridge() {
    if systemd_manages codex-bridge; then
        echo -e "\033[32m✔ Bridge Server dikelola systemd (codex-bridge)\033[0m"
        return 0
    fi

    if is_bridge_running; then
        echo -e "\033[32m✔ Bridge Server is already running on port $PORT\033[0m"
        return 0
    fi

    echo -e "\033[34m▶ Starting Bridge Server on port $PORT...\033[0m"
    cd "$APP_DIR/bridge"
    
    if [ ! -d "node_modules" ]; then
        npm install --silent >/dev/null 2>&1 || true
    fi

    PORT="$PORT" TOKEN="$TOKEN" DEFAULT_ENGINE="$ENGINE" nohup node server.js >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    local attempts=0
    while [ $attempts -lt 10 ]; do
        sleep 0.5
        if curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
            echo -e "\033[32m✔ Bridge Server started successfully (PID: $pid)\033[0m"
            return 0
        fi
        attempts=$((attempts + 1))
    done

    echo -e "\033[33m⚠ Bridge Server started with PID $pid (checking health...)\033[0m"
}

get_tunnel_url() {
    # The systemd unit logs to ~/tunnel.log; the standalone mode uses DATA_DIR.
    local f
    for f in "$HOME/tunnel.log" "$TUNNEL_LOG"; do
        if [ -f "$f" ]; then
            local found
            found=$(grep -oE "https://[a-zA-Z0-9.-]+\.trycloudflare\.com" "$f" | tail -n 1)
            if [ -n "$found" ]; then
                echo "$found"
                return 0
            fi
        fi
    done
    journalctl -u codex-tunnel -n 200 --no-pager 2>/dev/null \
        | grep -oE "https://[a-zA-Z0-9.-]+\.trycloudflare\.com" | tail -n 1
}

start_tunnel() {
    if systemd_manages codex-tunnel; then
        echo -e "\033[32m✔ Cloudflare Tunnel dikelola systemd (codex-tunnel)\033[0m"
        return 0
    fi

    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "\033[33m⚠ cloudflared is not installed. Running local server only.\033[0m"
        return 0
    fi

    if is_tunnel_running; then
        local url
        url=$(get_tunnel_url)
        if [ -n "$url" ]; then
            echo -e "\033[32m✔ Cloudflare Tunnel is active: $url\033[0m"
            return 0
        fi
    fi

    echo -e "\033[34m▶ Starting Cloudflare Tunnel...\033[0m"
    > "$TUNNEL_LOG"
    nohup cloudflared tunnel --url "http://127.0.0.1:$PORT" >> "$TUNNEL_LOG" 2>&1 &
    local pid=$!
    echo "$pid" > "$TUNNEL_PID_FILE"

    local attempts=0
    local url=""
    while [ $attempts -lt 25 ]; do
        sleep 0.5
        url=$(get_tunnel_url)
        if [ -n "$url" ]; then
            echo -e "\033[32m✔ Cloudflare Tunnel established: $url\033[0m"
            return 0
        fi
        attempts=$((attempts + 1))
    done

    echo -e "\033[33m⚠ Cloudflare Tunnel running (PID: $pid). Generating URL in background...\033[0m"
}

stop_all() {
    echo -e "\033[33m■ Stopping Antigravity Remote Bridge & Tunnel...\033[0m"
    
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi

    if [ -f "$TUNNEL_PID_FILE" ]; then
        local tpid
        tpid=$(cat "$TUNNEL_PID_FILE" 2>/dev/null || true)
        if [ -n "$tpid" ]; then
            kill "$tpid" 2>/dev/null || true
        fi
        rm -f "$TUNNEL_PID_FILE"
    fi

    if command -v fuser >/dev/null 2>&1; then
        fuser -k "$PORT/tcp" 2>/dev/null || true
    fi
    pkill -f "cloudflared tunnel --url http://127.0.0.1:$PORT" 2>/dev/null || true

    echo -e "\033[32m✔ All services stopped.\033[0m"
}

show_status() {
    echo -e "\033[1;36m===================================================\033[0m"
    echo -e "\033[1;36m  🌌 Antigravity & Codex Remote Status             \033[0m"
    echo -e "\033[1;36m===================================================\033[0m"
    
    local bridge_ok=false
    if is_bridge_running && curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
        bridge_ok=true
        echo -e "  Bridge Server : \033[32m● ONLINE\033[0m (Port: $PORT)"
    else
        echo -e "  Bridge Server : \033[31m○ OFFLINE\033[0m"
    fi

    local tunnel_url
    tunnel_url=$(get_tunnel_url)
    if is_tunnel_running && [ -n "$tunnel_url" ]; then
        echo -e "  Public Tunnel : \033[32m● ACTIVE\033[0m"
        echo -e "  Tunnel URL    : \033[1;34m$tunnel_url\033[0m"
    else
        echo -e "  Public Tunnel : \033[33m○ INACTIVE / LOCAL ONLY\033[0m"
    fi

    echo -e "  Auth Token    : \033[33m$TOKEN\033[0m"
    echo -e "  Default Engine: \033[35m$ENGINE\033[0m"
    echo -e "\033[1;36m===================================================\033[0m"
}

show_qr_pair() {
    start_bridge
    start_tunnel

    local tunnel_url=""
    local attempts=0
    while [ $attempts -lt 20 ]; do
        tunnel_url=$(get_tunnel_url)
        if [ -n "$tunnel_url" ]; then
            break
        fi
        sleep 0.5
        attempts=$((attempts + 1))
    done

    local endpoint_url
    if [ -n "$tunnel_url" ]; then
        endpoint_url="$tunnel_url/api/chat"
    else
        local local_ip
        local_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
        endpoint_url="http://$local_ip:$PORT/api/chat"
    fi

    cd "$APP_DIR/bridge"
    BRIDGE_URL="$endpoint_url" DEFAULT_ENGINE="$ENGINE" node pair.js
}

show_logs() {
    echo -e "\033[34m▶ Showing logs (Press Ctrl+C to exit)...\033[0m"
    touch "$LOG_FILE"
    tail -f "$LOG_FILE"
}

case "$1" in
    start)
        start_bridge
        start_tunnel
        show_status
        ;;
    stop)
        stop_all
        ;;
    restart)
        echo -e "\033[34m▶ Gracefully restarting Antigravity Remote Bridge...\033[0m"
        if [ -f "$PID_FILE" ]; then
            old_pid=$(cat "$PID_FILE" 2>/dev/null || true)
            if [ -n "$old_pid" ]; then
                kill "$old_pid" 2>/dev/null || true
            fi
            rm -f "$PID_FILE"
        fi
        sleep 0.5
        start_bridge
        if ! is_tunnel_running; then
            start_tunnel
        fi
        show_status
        ;;
    status)
        show_status
        ;;
    pair|qr|"")
        show_qr_pair
        ;;
    logs|log)
        show_logs
        ;;
    rotate|rotate-token)
        NEW_TOKEN=$(node -e "process.stdout.write(require('$APP_DIR/bridge/config.js').rotateToken())" 2>/dev/null)
        if [ -z "$NEW_TOKEN" ]; then
            echo -e "\033[31m✘ Gagal membuat token baru.\033[0m"
            exit 1
        fi
        TOKEN="$NEW_TOKEN"
        echo -e "\033[32m✔ Token baru dibuat: $TOKEN\033[0m"
        echo -e "  Restart server lalu scan ulang QR pairing dari HP."
        echo -e "  Catatan: semua perangkat yang terpasang perlu pairing ulang."
        if systemd_manages codex-bridge; then
            sudo systemctl restart codex-bridge || true
        else
            "$0" restart >/dev/null 2>&1 || true
        fi
        sleep 2
        show_qr_pair
        ;;
    token)
        if [ -n "$2" ]; then
            TOKEN="$2"
            write_token "$TOKEN"
            save_env
            echo -e "\033[32m✔ Token updated to: $TOKEN\033[0m"
            echo -e "Restarting server with new token..."
            $0 restart
        else
            echo -e "Current Auth Token: \033[1;33m$TOKEN\033[0m"
            echo -e "To change token: codex-remote token <new-secret-token>"
        fi
        ;;
    engine)
        if [ -n "$2" ]; then
            ENGINE="$2"
            save_env
            echo -e "\033[32m✔ Default engine updated to: $ENGINE\033[0m"
            $0 restart
        else
            echo -e "Current Default Engine: \033[1;35m$ENGINE\033[0m"
            echo -e "To change engine: codex-remote engine <antigravity|codex|opencode|commandcode>"
        fi
        ;;
    help|--help|-h)
        echo "Antigravity & Codex Remote CLI"
        echo ""
        echo "Usage:"
        echo "  codex-remote [command]"
        echo "  agy-remote [command]"
        echo ""
        echo "Commands:"
        echo "  (no args) / pair : Show QR Code pairing & connect link"
        echo "  start            : Start Bridge Server & Tunnel in background"
        echo "  stop             : Stop Bridge Server & Tunnel"
        echo "  restart          : Restart Bridge Server & Tunnel"
        echo "  status           : Show status of server, port, and tunnel URL"
        echo "  logs             : Stream live server logs"
        echo "  token [new]      : View or change secret Bearer Token"
        echo "  rotate           : Generate a fresh token (re-pair required)"
        echo "  engine [name]    : View or change default engine (antigravity / codex / opencode / commandcode)"
        echo ""
        ;;
    *)
        echo -e "\033[31mUnknown command: $1\033[0m"
        echo "Run 'codex-remote help' for available commands."
        exit 1
        ;;
esac
